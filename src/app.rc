#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ITALIAN, SUBLANG_ITALIAN

IDI_APP ICON "stackly.ico"

1 RT_MANIFEST "app.manifest"

IDR_LISTMENU MENU
BEGIN
    POPUP "list"
    BEGIN
        MENUITEM "&Apri file\tInvio",                ID_DL_OPENFILE
        MENUITEM "Mostra nella &cartella",           ID_DL_OPENITEMFOLDER
        MENUITEM "Copia &URL\tCtrl+C",               ID_DL_COPYURL
        MENUITEM SEPARATOR
        MENUITEM "&Riprova",                         ID_DL_RETRY
        MENUITEM "A&nnulla",                         ID_DL_CANCEL
        MENUITEM "Ri&muovi dall'elenco\tCanc",       ID_DL_REMOVE
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "V", ID_FILE_PASTE,      VIRTKEY, CONTROL, SHIFT
    "O", ID_FILE_OPENFOLDER, VIRTKEY, CONTROL
END

IDD_SETTINGS DIALOGEX 0, 0, 320, 232
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Impostazioni"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Percorso yt-dlp.exe (vuoto = automatico):", -1, 10, 10, 300, 9
    EDITTEXT        IDC_SET_YTDLP, 10, 21, 240, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Sfoglia...", IDC_SET_YTDLP_BR, 256, 20, 54, 15

    LTEXT           "Percorso ffmpeg.exe (vuoto = automatico):", -1, 10, 40, 300, 9
    EDITTEXT        IDC_SET_FFMPEG, 10, 51, 240, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Sfoglia...", IDC_SET_FFMPEG_BR, 256, 50, 54, 15

    LTEXT           "Lingue sottotitoli (es. it.*,en.*):", -1, 10, 72, 140, 9
    EDITTEXT        IDC_SET_SUBLANGS, 10, 83, 140, 13, ES_AUTOHSCROLL
    LTEXT           "Download insieme:", -1, 162, 72, 70, 9
    EDITTEXT        IDC_SET_MAXDL, 162, 83, 40, 13, ES_NUMBER
    CONTROL         "", IDC_SET_MAXDL_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 202, 83, 10, 13
    LTEXT           "Connessioni per file:", -1, 236, 72, 80, 9
    EDITTEXT        IDC_SET_FRAGS, 236, 83, 40, 13, ES_NUMBER
    CONTROL         "", IDC_SET_FRAGS_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 276, 83, 10, 13

    AUTOCHECKBOX    "Download segmentato nativo (più connessioni per file)", IDC_SET_SEGMENTED, 10, 104, 300, 10
    AUTOCHECKBOX    "Usa anche i sottotitoli generati automaticamente", IDC_SET_AUTOSUBS, 10, 118, 300, 10
    AUTOCHECKBOX    "Chiudendo la finestra, resta nell'area di notifica", IDC_SET_TRAY, 10, 132, 300, 10

    LTEXT           "Argomenti extra per yt-dlp (avanzato):", -1, 10, 150, 300, 9
    EDITTEXT        IDC_SET_EXTRA, 10, 161, 300, 13, ES_AUTOHSCROLL
    LTEXT           "Le connessioni valgono sia per i file singoli sia per i frammenti HLS/DASH (RaiPlay, Mediaset, Twitch...).", -1, 10, 180, 300, 18

    DEFPUSHBUTTON   "OK", IDOK, 202, 208, 52, 15
    PUSHBUTTON      "Annulla", IDCANCEL, 258, 208, 52, 15
END

// La finestra dei formati crea i propri controlli via codice (layout ridimensionabile)
IDD_PICKER DIALOGEX 0, 0, 480, 340
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "Scegli i formati"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END

// Informazioni: disegnata interamente via codice
IDD_ABOUT DIALOGEX 0, 0, 300, 260
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Informazioni su Stackly"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION STACKLY_VERSION_NUM
 PRODUCTVERSION STACKLY_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041004b0"
        BEGIN
            VALUE "FileDescription", "Stackly - interfaccia semplice per yt-dlp"
            VALUE "FileVersion", STACKLY_VERSION_STR
            VALUE "InternalName", "Stackly"
            VALUE "OriginalFilename", "Stackly.exe"
            VALUE "ProductName", "Stackly"
            VALUE "ProductVersion", STACKLY_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x410, 1200
    END
END
